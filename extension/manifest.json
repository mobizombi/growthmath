{
  "manifest_version": 3,
  "name": "GrowthMath - UTM Builder, SEO Check & Marketing Calculators",
  "short_name": "GrowthMath",
  "version": "1.0.0",
  "description": "Tag the current page with UTMs in one click, check its SEO title and description, and run ROAS, CPA and margin maths.",
  "homepage_url": "https://growthmath.io/",
  "action": {
    "default_popup": "popup.html",
    "default_title": "GrowthMath",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "permissions": ["activeTab", "scripting", "storage"]
}
